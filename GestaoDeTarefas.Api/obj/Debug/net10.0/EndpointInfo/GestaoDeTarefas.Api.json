{
  "openapi": "3.1.1",
  "info": {
    "title": "API de Gestão de Tarefas",
    "description": "## API de Gestão de Tarefas\r\n\r\n### Como usar:\r\n1. Para criar uma tarefa, envie um `POST` para `/api/tarefas`.\r\n2. O formato de data utilizado para vencimentos é `YYYY-MM-DD`.\r\n3. É possível criar uma tarefa com os status:\r\n\r\n    Pendente;\r\n\r\n    EmProgresso;\r\n\r\n    Concluida;\r\n    \r\n    Ou caso, prefira, com o Id, que corresponde aos seguintes status:\r\n\r\n    1 = Pendente;\r\n\r\n    2 = EmProgresso;\r\n\r\n    3 = Concluida;\r\n\r\n    Sempre retornará a descrição do status.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://localhost:7111"
    },
    {
      "url": "http://localhost:5187"
    }
  ],
  "paths": {
    "/api/Tarefas": {
      "post": {
        "tags": [
          "Tarefas"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CriarTarefaDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CriarTarefaDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CriarTarefaDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "tags": [
          "Tarefas"
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/StatusTarefa"
            }
          },
          {
            "name": "dataVencimento",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Tarefas/{id}": {
      "get": {
        "tags": [
          "Tarefas"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "tags": [
          "Tarefas"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AtualizarTarefaDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AtualizarTarefaDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AtualizarTarefaDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "tags": [
          "Tarefas"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AtualizarTarefaDto": {
        "required": [
          "titulo",
          "descricao",
          "dataVencimento",
          "status"
        ],
        "type": "object",
        "properties": {
          "titulo": {
            "type": "string"
          },
          "descricao": {
            "type": [
              "null",
              "string"
            ]
          },
          "dataVencimento": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "status": {
            "$ref": "#/components/schemas/StatusTarefa"
          }
        }
      },
      "CriarTarefaDto": {
        "required": [
          "titulo",
          "descricao",
          "dataVencimento"
        ],
        "type": "object",
        "properties": {
          "titulo": {
            "type": "string"
          },
          "descricao": {
            "type": [
              "null",
              "string"
            ]
          },
          "dataVencimento": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "status": {
            "$ref": "#/components/schemas/StatusTarefa"
          }
        }
      },
      "StatusTarefa": {
        "enum": [
          "Pendente",
          "EmProgresso",
          "Concluida"
        ],
        "default": "Pendente"
      }
    }
  },
  "tags": [
    {
      "name": "Tarefas"
    }
  ]
}